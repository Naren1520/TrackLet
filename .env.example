# ==========================================
# TrackLet - Environment Configuration
# ==========================================
# Copy this file to .env.local and update the values.

# Single-user credentials
APP_USERNAME="admin"

# Bcrypt hash of your password.
# To generate a hash, run: node -e "console.log(require('bcryptjs').hashSync('YourPassword', 10))"
# Note: In Next.js .env files, $ must be escaped as \$ to prevent variable substitution
APP_PASSWORD_HASH="\$2a\$10\$exampleHashReplaceWithYourOwnBcryptHashHere"

# Secret used to sign session cookies with jose (minimum 32 characters)
SESSION_SECRET="your-secure-random-session-secret-at-least-32-chars-long"

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"

# MongoDB Database name
MONGODB_DB_NAME="tracklet"
